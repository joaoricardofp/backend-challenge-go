DATABASE_URL="postgres://postgres:postgres@localhost:5432/backend-challenge-go"
# OIDC (Keycloak como referência). Com OIDC_ENABLED=true (default), o server
# recusa iniciar sem OIDC_ISSUER. OIDC_AUDIENCE vazio desliga checagem de aud.
OIDC_ENABLED="true"
OIDC_ISSUER="http://localhost:8081/realms/wager"
OIDC_AUDIENCE="wager-api"
# SQS (B3.13): filas separadas. Desligado sem SQS_ENABLED=true.
# Consumer de wagering lê SOMENTE SQS_WAGER_QUEUE_URL; o publisher da outbox
# publica SOMENTE em SQS_OUTBOX_QUEUE_URL; eventos esgotados vão para
# SQS_OUTBOX_DLQ_URL (quando configurada). Retry: 2^(n-1)s com teto.
# SQS_ENABLED="false"
# SQS_WAGER_QUEUE_URL="http://localhost:4566/000000000000/wager-input"
# SQS_OUTBOX_QUEUE_URL="http://localhost:4566/000000000000/wager-events"
# SQS_OUTBOX_DLQ_URL="http://localhost:4566/000000000000/wager-events-dlq"
# SQS_REGION="us-east-1"
# SQS_ENDPOINT="http://localhost:4566"
# SQS_MAX_MESSAGES="10"
# SQS_WAIT_TIME_SECONDS="20"
# SQS_VISIBILITY_TIMEOUT_SECONDS="30"
# SQS_OUTBOX_POLL_INTERVAL_SECONDS="1"
# SQS_OUTBOX_BATCH_SIZE="10"
# SQS_OUTBOX_MAX_ATTEMPTS="5"
# SQS_OUTBOX_MAX_BACKOFF_SECONDS="300"
# Worker de PENDING_REFERENCE (README §7): retry com backoff 2^(n-1)s e
# REJECTED/REFERENCE_NOT_FOUND ao esgotar MaxAttempts. Habilitado por padrão.
# PENDING_RESOLVER_ENABLED="true"
# PENDING_RESOLVER_INTERVAL_SECONDS="5"
# PENDING_RESOLVER_BATCH_SIZE="10"
# PENDING_RESOLVER_MAX_ATTEMPTS="10"
# PENDING_RESOLVER_MAX_BACKOFF_SECONDS="300"
